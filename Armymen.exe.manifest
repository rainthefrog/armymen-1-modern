<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  External application manifest for Armymen.exe (the exe has none embedded).
  Put it next to Armymen.exe together with ddraw.dll.

  Without a manifest Windows treats the game as an unknown legacy program and applies automatic
  compatibility fixes, such as "DWM8And16BitMitigation" (reduced colour mode). That fix changes the
  screen mode and turns off display-scaling awareness. Our ddraw.dll never uses 256-colour modes,
  so the game needs none of that. This manifest tells Windows:
    - the game supports Windows 7 to 11 (supportedOS), so it is not handled as a legacy program
    - it handles display scaling itself (per-monitor v2), so Windows does not stretch its window
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <assemblyIdentity type="win32" name="ArmyMen.Game" version="1.0.0.0" processorArchitecture="x86"/>
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
      <!-- Windows 8.1 -->
      <supportedOS Id="{1f676c76-80e1-4239-95bb-83d0f6d0da78}"/>
      <!-- Windows 8 -->
      <supportedOS Id="{4a2f28e3-53b9-4441-ba9c-d69d4a4a6e38}"/>
      <!-- Windows 7 -->
      <supportedOS Id="{35138b9a-5d96-4fbd-8e2d-a2440225f93a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
